+    pub fn intern(&mut self, s: &str) -> StringId {
+        if let Some(&id) = self.dedup.get(s) {
+            return id;
+        }
+        let id = StringId(self.strings.len() as u32);
+        self.strings.push(s.to_owned());
+        self.dedup.insert(s.to_owned(), id);
